name: CI
on: [push, pull_request]
jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: npm
      - run: npm ci
      - run: npm run typecheck
      - run: npm run test
      - run: npm run typecheck:web
      - run: npm run build:web
      - name: Install the browser for end-to-end tests
        run: npx playwright install --with-deps chromium
        working-directory: apps/web
      - run: npm run test:e2e
      - name: Fail if player data was committed
        run: |
          if git ls-files | grep -Ei '(\.season\.json|\.roster\.json|^data/(?!\.gitkeep))' ; then
            echo "Player data found in the repository. Remove it."; exit 1
          fi
          echo "No player data in the repository."

# Builds the console and publishes it to GitHub Pages on every push to main.
# Set Settings > Pages > Source to "GitHub Actions" once, then never again.
name: Deploy console

on:
  push:
    branches: [main]
  workflow_dispatch:          # lets you deploy by hand from the Actions tab

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: npm
      - run: npm ci
      # Never publish a build that does not pass. A broken console is worse
      # than yesterday's working one.
      - run: npm run typecheck
      - run: npm run test
      - run: npm run build:web
      - uses: actions/configure-pages@v5
      - uses: actions/upload-pages-artifact@v3
        with:
          path: apps/web/dist

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4
