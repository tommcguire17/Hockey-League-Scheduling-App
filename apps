import { useMemo, useState } from 'react';
import type { Season, LeagueManifest } from '@league/core';
import {
  PLAYOFF_TYPES, ROUND_LABELS, codeOfGameId, fmtDate, fmtDay, fmtTime, gameWhen,
  isPlayed, resultProgress, standings,
} from '@league/core';
import { names } from '../lib/names';

/** Entering scores, and the standings they produce. */
export function Results(
  { season, manifest, onChange }:
  { season: Season; manifest: LeagueManifest; onChange: (s: Season) => void },
) {
  const [div, setDiv] = useState('all');
  const [only, setOnly] = useState<'all' | 'open'>('all');

  const slot = useMemo(() => new Map(season.slots.map((s) => [s.id, s])), [season]);
  const name = useMemo(() => new Map(season.teams.map((t) => [t.id, t.name])), [season]);
  const nameOf = useMemo(() => names(season), [season]);
  const table = useMemo(() => standings(season, manifest), [season, manifest]);
  const progress = resultProgress(season);

  const setScore = (id: string, side: 'homeGoals' | 'awayGoals', raw: string) => {
    const v = raw.trim() === '' ? null : Math.max(0, Math.floor(Number(raw)));
    if (v !== null && !Number.isFinite(v)) return;
    onChange({ ...season, games: season.games.map((g) => (g.id === id ? { ...g, [side]: v } : g)) });
  };

  const rows = season.games
    .map((g) => ({ g, w: gameWhen(g, slot) }))
    .filter((x) => x.w)
    .filter((x) => div === 'all' || x.g.divisionId === div)
    .filter((x) => only === 'all' || !isPlayed(x.g))
    .sort((a, b) => (a.w!.date + a.w!.start).localeCompare(b.w!.date + b.w!.start));

  const today = new Date().toISOString().slice(0, 10);

  return (
    <>
      <h2>Results</h2>
      <p className="lede">
        {progress.played} of {progress.total} regular-season games have a score.
        Standings below update as you type.
      </p>

      <div className="row">
        <div className="field">
          <label htmlFor="rdiv">Division</label>
          <select id="rdiv" value={div} onChange={(e) => setDiv(e.target.value)}>
            <option value="all">All divisions</option>
            {season.divisions.map((d) => <option key={d.id} value={d.id}>{d.name}</option>)}
          </select>
        </div>
        <div className="field">
          <label htmlFor="ronly">Show</label>
          <select id="ronly" value={only} onChange={(e) => setOnly(e.target.value as 'all' | 'open')}>
            <option value="all">Every game</option>
            <option value="open">Still waiting on a score</option>
          </select>
        </div>
        <div className="field"><label>&nbsp;</label><span className="muted">{rows.length} games</span></div>
      </div>

      <div className="scroll-x">
        <table>
          <thead>
            <tr><th>Date</th><th>Day</th><th>Time</th><th>Division</th><th>Home</th>
              <th className="num">Goals</th><th className="num">Goals</th><th>Visitor</th><th>Result</th></tr>
          </thead>
          <tbody>
            {rows.map(({ g, w }) => {
              const played = isPlayed(g);
              const past = w!.date <= today;
              // A bracket game with an unknown side cannot take a score: there
              // is nobody to credit it to, and typing one in would only look
              // like a result.
              const pending = PLAYOFF_TYPES.has(g.type) && !(g.homeTeamId && g.awayTeamId);
              return (
                <tr key={g.id}>
                  <td>{fmtDate(w!.date)}</td>
                  <td className="muted">{fmtDay(w!.date)}</td>
                  <td>{fmtTime(w!.start)}</td>
                  <td><span className="chip div">{nameOf.division(g.divisionId)}</span>
                    {PLAYOFF_TYPES.has(g.type) && (
                      <span className="chip po" title={ROUND_LABELS[g.type]}>
                        {codeOfGameId(g.id).toUpperCase()}</span>
                    )}</td>
                  <td>{name.get(g.homeTeamId ?? '') ?? g.homeLabel}</td>
                  <td className="num">
                    <input type="number" min={0} className="score" value={g.homeGoals ?? ''}
                      disabled={pending} title={pending ? 'Waiting on the round before this one' : undefined}
                      aria-label={`${name.get(g.homeTeamId ?? '') ?? 'home'} goals`}
                      onChange={(e) => setScore(g.id, 'homeGoals', e.target.value)} />
                  </td>
                  <td className="num">
                    <input type="number" min={0} className="score" value={g.awayGoals ?? ''}
                      disabled={pending} title={pending ? 'Waiting on the round before this one' : undefined}
                      aria-label={`${name.get(g.awayTeamId ?? '') ?? 'visitor'} goals`}
                      onChange={(e) => setScore(g.id, 'awayGoals', e.target.value)} />
                  </td>
                  <td>{name.get(g.awayTeamId ?? '') ?? g.awayLabel}</td>
                  <td>{pending ? <span className="muted">bracket</span>
                    : resultOf(g, name, played, past)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      {manifest.capabilities.standings && (
        <>
          <h2 style={{ marginTop: 26 }}>Standings</h2>
          {season.divisions.map((d) => {
            const rs = table.filter((r) => r.divisionId === d.id);
            if (!rs.length) return null;
            return (
              <div className="panel" key={d.id}>
                <h3>{d.name}</h3>
                <table>
                  <thead>
                    <tr><th className="num">#</th><th>Team</th><th className="num">GP</th>
                      <th className="num">W</th><th className="num">L</th><th className="num">T</th>
                      <th className="num">Pts</th><th className="num">GF</th><th className="num">GA</th>
                      <th className="num">+/-</th><th>Last 5</th></tr>
                  </thead>
                  <tbody>
                    {rs.map((r) => (
                      <tr key={r.teamId}>
                        <td className="num muted">{r.rank}</td>
                        <td><strong>{r.teamName}</strong></td>
                        <td className="num">{r.played}</td><td className="num">{r.won}</td>
                        <td className="num">{r.lost}</td><td className="num">{r.tied}</td>
                        <td className="num"><strong>{r.points}</strong></td>
                        <td className="num">{r.goalsFor}</td><td className="num">{r.goalsAgainst}</td>
                        <td className="num">{r.diff > 0 ? `+${r.diff}` : r.diff}</td>
                        <td>{r.form.slice(0, 5).map((f, i) => (
                          <i key={i} className={`form f${f}`}>{f}</i>
                        ))}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            );
          })}
        </>
      )}
    </>
  );
}

function resultOf(
  g: { homeTeamId: string | null; awayTeamId: string | null; homeGoals: number | null; awayGoals: number | null },
  name: Map<string, string>, played: boolean, past: boolean,
) {
  if (!played) {
    return past ? <span className="flag wrn">needs a score</span> : <span className="muted">to come</span>;
  }
  if (g.homeGoals === g.awayGoals) return <span className="muted">tie</span>;
  const winner = g.homeGoals! > g.awayGoals! ? g.homeTeamId : g.awayTeamId;
  return <span className="flag ok">{name.get(winner ?? '') ?? 'winner'}</span>;
}

import { useMemo, useRef, useState } from 'react';
import type { IceRule, OwnerPolicy, Season, Slot, SlotUse, Weekday } from '@league/core';
import {
  FORMAT_LABEL, applyIceRules, describeRule, fmtDate, fmtDay, fmtTime, isRepurposed,
  repurposeSlot, repurposedSlots, revertSlot, slotHolds, slotIsBusy, suggestIceRules,
} from '@league/core';
import { importIceSlots, type ImportIssue } from '@league/io';
import { readFile } from '../lib/files';
import { useRevealOnOpen } from '../lib/scroll';

const WEEKDAYS: Weekday[] = [
  'sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday',
];

const USES: { v: SlotUse; label: string; hint: string }[] = [
  { v: 'game', label: 'Game', hint: 'Regular-season games' },
  { v: 'practice', label: 'Practice', hint: 'Practice ice' },
  { v: 'evaluation', label: 'Evaluation', hint: 'Evaluation skates, before the season opens' },
  {
    v: 'playoff',
    label: 'Playoff',
    // Marking ice as the playoffs' own is how the rink sets the end of the
    // regular season. The generator cannot put a regular game here at all,
    // so the rest of the season has to fit in front of it — which is the
    // point, and where the doubled-up weekends come from.
    hint: 'Held for the brackets. The regular season must finish before it.',
  },
  { v: 'unused', label: 'Out of play', hint: 'Booked but not being used' },
];

export function Ice({ season, onChange }: { season: Season; onChange: (s: Season) => void }) {
  const [rink, setRink] = useState('all');
  const [use, setUse] = useState('all');
  const [issues, setIssues] = useState<ImportIssue[]>([]);
  const [note, setNote] = useState('');
  /**
   * Both of these sit above a table of every slot in the season. Opening the
   * rules panel, or adding a slot, from the bottom of that table used to
   * change the top of the page out of sight. A new slot is dated to the season
   * start, so it lands at the top of the list too — right under the note that
   * says it was added.
   */
  const rulesRef = useRef<HTMLDivElement | null>(null);
  const noteRef = useRef<HTMLDivElement | null>(null);

  const [showRules, setShowRules] = useState(false);
  useRevealOnOpen(rulesRef, showRules);
  useRevealOnOpen(noteRef, note);

  const usedSlots = useMemo(() => {
    const m = new Map<string, number>();
    for (const g of season.games) if (g.slotId) m.set(g.slotId, (m.get(g.slotId) ?? 0) + 1);
    for (const p of season.practices) if (p.teamIds.length) m.set(p.slotId, (m.get(p.slotId) ?? 0) + p.teamIds.length);
    return m;
  }, [season]);

  const rinks = useMemo(() => [...new Set(season.slots.map((s) => s.rink))].sort(), [season]);
  const moved = repurposedSlots(season);
  /**
   * Date order, always. The list was showing slots in whatever order the
   * season file happened to hold them, which is import order — fine until
   * you add a sheet by hand, which appends it. A slot dated early January
   * then appeared below one in late February, under a note saying to correct
   * its date "below".
   */
  const rows = season.slots
    .filter((s) => (rink === 'all' || s.rink === rink)
      && (use === 'all' || (use === 'repurposed' ? isRepurposed(s) : s.use === use)))
    .sort((a, b) => (a.date + a.start + a.rink).localeCompare(b.date + b.start + b.rink));

  const edit = (id: string, patch: Partial<Slot>) =>
    onChange({ ...season, slots: season.slots.map((s) => (s.id === id ? { ...s, ...patch } : s)) });

  /**
   * Changing what a slot is for is a decision, not a typo fix: it is recorded
   * against what the building booked, protected from the rules pass, and
   * listed in the handback to whoever keeps Finnly.
   */
  const changeUse = (slot: Slot, use: SlotUse) => {
    if (use === slot.use) return;
    if (slotIsBusy(season, slot.id)
      && !confirm('Something is booked on this slot. Change what it is for anyway?')) return;
    const booked = slot.bookedUse ?? slot.use;
    const note = use === booked ? '' : (prompt(
      `This slot was booked as ${booked}. Why is it being used for ${use}?`,
      slot.repurposeNote || '') ?? '');
    onChange(repurposeSlot(season, slot.id, use, { note }));
  };

  const remove = (id: string) => {
    if (usedSlots.has(id) && !confirm('Something is booked in this slot. Remove it anyway?')) return;
    onChange({
      ...season,
      slots: season.slots.filter((s) => s.id !== id),
      games: season.games.map((g) => (g.slotId === id ? { ...g, slotId: null } : g)),
      practices: season.practices.filter((p) => p.slotId !== id),
    });
  };

  /** A blank slot you fill in, dated today or the season start. */
  const add = () => {
    const date = season.startDate;
    let n = 1;
    let id = `manual-${date}-${n}`;
    while (season.slots.some((s) => s.id === id)) id = `manual-${date}-${++n}`;
    const slot: Slot = {
      id, date, start: '18:00', minutes: 60,
      rink: rinks[0] ?? 'Red Hawk', use: 'game', capacity: 0, practiceTeams: 0,
      ownerDivisionId: null, ownerPolicy: 'priority',
      bookedUse: 'game', repurposeNote: '', tag: 'added by hand',
    };
    onChange({ ...season, slots: [...season.slots, slot] });
    setNote(`Added a slot on ${fmtDate(date)}. Change its date, time and rink below.`);
    setIssues([]);
  };

  async function importCsv() {
    const f = await readFile('.csv,text/csv');
    if (!f) return;
    try {
      const r = importIceSlots(f.text, {
        defaultUse: 'game',
        divisionIds: season.divisions.map((d) => d.id),
      });
      const key = (s: { date: string; start: string; rink: string }) =>
        `${s.date}|${s.start}|${s.rink}`;
      const byKey = new Map(season.slots.map((s) => [key(s), s]));
      const fresh = r.items.filter((s) => !byKey.has(key(s)));
      const dupes = r.items.length - fresh.length;

      // A slot we deliberately repurposed keeps our use, as agreed: the file
      // says what the building booked, we say what is happening on the ice.
      // The difference is reported rather than silently resolved either way.
      const conflicts = r.items
        .map((s) => ({ incoming: s, have: byKey.get(key(s)) }))
        .filter((x) => x.have && x.have.use !== x.incoming.use);

      onChange({
        ...season,
        slots: [...season.slots, ...fresh]
          .sort((a, b) => (a.date + a.start + a.rink).localeCompare(b.date + b.start + b.rink)),
      });
      setIssues([
        ...r.issues,
        ...conflicts.map((c) => ({
          row: 0,
          message: `${c.incoming.date} ${fmtTime(c.incoming.start)} ${c.incoming.rink}: the file says `
            + `${c.incoming.use}, this season has it as ${c.have!.use}. Kept as `
            + `${c.have!.use}; it is on the ice differences export.`,
        })),
      ]);
      setNote(`${f.name}: added ${fresh.length} slots`
        + (dupes ? `, skipped ${dupes} already here` : '')
        + (conflicts.length ? `, kept ${conflicts.length} of your own changes` : '')
        + (r.skipped ? `, could not read ${r.skipped} rows` : '') + '.');
    } catch (e) {
      setIssues([]);
      setNote(e instanceof Error ? e.message : String(e));
    }
  }

  const freeCount = season.slots.filter((s) => !usedSlots.has(s.id)).length;
  const divName = (id: string) => season.divisions.find((d) => d.id === id)?.name ?? id;

  // ---- standing rules -------------------------------------------------------
  const setRules = (iceRules: IceRule[]) => onChange({ ...season, iceRules });

  const editRule = (id: string, patch: Partial<IceRule>) =>
    setRules(season.iceRules.map((r) => (r.id === id ? { ...r, ...patch } : r)));

  const findRules = () => {
    const found = suggestIceRules(season);
    // Match on what a rule SELECTS, not on its id. Two rules for Wednesday at
    // 18:10 are the same rule however they were named, and deduping by id
    // quietly doubled the table every time this was pressed.
    const sig = (r: IceRule) =>
      `${[...r.weekdays].sort().join(',')}|${r.start ?? ''}|${r.rink}|${r.matchUse ?? ''}`;
    const have = new Set(season.iceRules.map(sig));
    const fresh = found.filter((r) => !have.has(sig(r)));
    setRules([...season.iceRules, ...fresh]);
    setShowRules(true);
    setNote(fresh.length
      ? `Found ${fresh.length} weekly patterns in the booked ice. Say who each one belongs to, then apply.`
      : 'No new weekly patterns found. Every repeating day and time already has a rule.');
  };

  /** A blank rule, for ice that does not repeat weekly. */
  const addRule = () => {
    let n = season.iceRules.length + 1;
    while (season.iceRules.some((r) => r.id === `rule-${n}`)) n++;
    setRules([...season.iceRules, {
      id: `rule-${n}`, weekdays: [], start: null, rink: '', matchUse: null,
      setUse: null, divisionId: null, policy: 'priority',
      capacity: 0, practiceTeams: 0, note: 'added by hand',
    }]);
    setShowRules(true);
  };

  const runRules = () => {
    const { season: next, applied } = applyIceRules(season);
    onChange(next);
    const total = applied.reduce((n, a) => n + a.matched, 0);
    const idle = applied.filter((a) => !a.matched).length;
    setNote(`Applied ${season.iceRules.length} rules to ${total} slots`
      + (idle ? `. ${idle} matched nothing — check the day, time and rink.` : '.'));
  };

  return (
    <>
      <h2>Booked ice</h2>
      <p className="lede">
        {season.slots.length
          ? `${season.slots.length} slots, ${freeCount} of them unused`
            + (moved.length
              ? `, ${moved.length} being used for something other than what the building booked. `
              : '. ')
            + 'Change what a slot is for and every count updates.'
          : 'No ice yet. Import a Finnly export, or add slots one at a time.'}
      </p>

      <div className="row">
        <button className="btn go" onClick={importCsv}>Import ice from CSV</button>
        <button className="btn line" onClick={add}>Add a slot</button>
        {season.slots.length > 0 && (
          <button className="btn line" onClick={() => setShowRules((v) => !v)}>
            {showRules ? 'Hide' : 'Who gets which ice'}
            {season.iceRules.length ? ` (${season.iceRules.length})` : ''}
          </button>
        )}
        {season.slots.length > 0 && (
          <>
            <div className="field">
              <label htmlFor="rink">Rink</label>
              <select id="rink" value={rink} onChange={(e) => setRink(e.target.value)}>
                <option value="all">All rinks</option>
                {rinks.map((r) => <option key={r}>{r}</option>)}
              </select>
            </div>
            <div className="field">
              <label htmlFor="use">Use</label>
              <select id="use" value={use} onChange={(e) => setUse(e.target.value)}>
                <option value="all">All</option>
                {USES.map((u) => <option key={u.v} value={u.v} title={u.hint}>{u.label}</option>)}
                <option value="repurposed">Used differently from booked</option>
              </select>
            </div>
            <div className="field"><label>&nbsp;</label><span className="muted">{rows.length} shown</span></div>
          </>
        )}
      </div>

      <div ref={rulesRef}>
      {showRules && (
        <div className="panel">
          <h3>Who gets which ice</h3>
          <p className="lede" style={{ marginBottom: 12 }}>
            A rink thinks in standing bookings: Wednesday at 18:10 is 8U practice, 7am Sunday is
            8U games. Set them here once and apply, instead of tagging {season.slots.length} rows
            by hand and hoping none were missed. Later rules win, so put the broad one first.
          </p>
          <div className="row">
            <button className="btn line" onClick={findRules}>Find the weekly patterns</button>
            <button className="btn line" onClick={addRule}>Add a rule</button>
            <button className="btn go" onClick={runRules} disabled={!season.iceRules.length}>
              Apply to the ice
            </button>
            {season.iceRules.length > 0 && (
              <button className="btn line" onClick={() => {
                if (confirm('Remove every rule? The slots keep whatever they are set to now.')) setRules([]);
              }}>Clear rules</button>
            )}
          </div>
          {season.iceRules.length === 0 ? (
            <p className="muted">
              No rules yet. <strong>Find the weekly patterns</strong> reads the booked ice and
              proposes one rule per repeating day and time.
            </p>
          ) : (
            <div className="scroll-x">
              <table>
                <thead>
                  <tr><th>Day</th><th>Start</th><th>Is for</th><th>Reserved for</th>
                    <th>When the owner is done</th><th className="num">At once</th>
                    <th className="num">Teams</th><th>Slots</th><th /></tr>
                </thead>
                <tbody>
                  {season.iceRules.map((r) => {
                    const hits = season.slots.filter((sl) => {
                      const wd = fmtDay(sl.date).toLowerCase();
                      return (!r.weekdays.length || r.weekdays.some((d) => d.startsWith(wd)))
                        && (!r.start || r.start === sl.start)
                        && (!r.rink || r.rink === sl.rink);
                    }).length;
                    return (
                      <tr key={r.id} title={describeRule(r, divName)}>
                        <td>
                          <select value={r.weekdays[0] ?? ''} aria-label={`${r.id} day`}
                            onChange={(e) => editRule(r.id, {
                              weekdays: e.target.value ? [e.target.value as Weekday] : [],
                            })}>
                            <option value="">Any day</option>
                            {WEEKDAYS.map((d) => (
                              <option key={d} value={d}>{d[0]!.toUpperCase() + d.slice(1)}</option>
                            ))}
                          </select>
                        </td>
                        <td>
                          <input type="time" value={r.start ?? ''} style={{ width: 96 }}
                            aria-label={`${r.id} start`}
                            onChange={(e) => editRule(r.id, { start: e.target.value || null })} />
                        </td>
                        <td>
                          <select value={r.setUse ?? ''} aria-label={`${r.id} use`}
                            onChange={(e) => editRule(r.id, { setUse: (e.target.value || null) as SlotUse | null })}>
                            <option value="">Leave as is</option>
                            {USES.map((u) => <option key={u.v} value={u.v} title={u.hint}>{u.label}</option>)}
                          </select>
                        </td>
                        <td>
                          <select value={r.divisionId ?? ''} aria-label={`${r.id} division`}
                            onChange={(e) => editRule(r.id, { divisionId: e.target.value || null })}>
                            <option value="">Anyone</option>
                            {season.divisions.map((d) => <option key={d.id} value={d.id}>{d.name}</option>)}
                          </select>
                        </td>
                        <td>
                          {r.divisionId ? (
                            <select value={r.policy} aria-label={`${r.id} policy`}
                              onChange={(e) => editRule(r.id, { policy: e.target.value as OwnerPolicy })}>
                              <option value="priority">open it to everyone</option>
                              <option value="exclusive">keep it reserved</option>
                            </select>
                          ) : <span className="muted">—</span>}
                        </td>
                        <td className="num">
                          <input type="number" min={0} max={4} className="score" value={r.capacity}
                            aria-label={`${r.id} games at once`}
                            onChange={(e) => editRule(r.id, { capacity: Math.max(0, Math.min(4, +e.target.value)) })} />
                        </td>
                        <td className="num">
                          <input type="number" min={0} max={6} className="score" value={r.practiceTeams}
                            aria-label={`${r.id} teams per practice`}
                            onChange={(e) => editRule(r.id, { practiceTeams: Math.max(0, Math.min(6, +e.target.value)) })} />
                        </td>
                        <td className={hits ? 'muted' : 'flag wrn'}>{hits || 'none'}</td>
                        <td>
                          <button className="btn line"
                            onClick={() => setRules(season.iceRules.filter((x) => x.id !== r.id))}>
                            Remove
                          </button>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
              <p className="muted" style={{ marginTop: 10 }}>
                <strong>At once</strong> is how many games share the sheet; 0 takes it from the
                division's ice format on Setup.
                <strong> Teams</strong> is how many share a practice; 0 works it out from the
                division. Both 0 means leave the slot alone.
              </p>
            </div>
          )}
        </div>
      )}
      </div>

      <div ref={noteRef}>{note && <p className="notice">{note}</p>}</div>
      {issues.length > 0 && (
        <details className="panel" open={issues.length <= 5}>
          <summary><strong>{issues.length} rows needed attention</strong></summary>
          <ul className="problems" style={{ marginTop: 10 }}>
            {issues.slice(0, 40).map((i, k) => <li key={k}>Row {i.row}: {i.message}</li>)}
            {issues.length > 40 && <li>and {issues.length - 40} more</li>}
          </ul>
        </details>
      )}

      {season.slots.length === 0 ? (
        <div className="empty">
          <p>Export the booked ice from Finnly as CSV and import it here. The columns it needs are
            a date, a start time and a facility; end time is used for the slot length if present.</p>
          <p>Or add slots one at a time if you are building a season by hand.</p>
        </div>
      ) : (
        <div className="scroll-x">
          <table>
            <thead>
              <tr>
                <th>Date</th><th>Day</th><th>Start</th><th className="num">Mins</th><th>Rink</th>
                <th>Use</th><th>Reserved for</th><th className="num">Holds</th><th>Booked</th><th />
              </tr>
            </thead>
            <tbody>
              {rows.map((s) => {
                const n = usedSlots.get(s.id) ?? 0;
                return (
                  <tr key={s.id}>
                    <td>
                      <input type="date" defaultValue={s.date} style={{ width: 138 }}
                        onBlur={(e) => e.target.value && edit(s.id, { date: e.target.value })} />
                    </td>
                    <td className="muted">{fmtDay(s.date)}</td>
                    <td>
                      <input type="time" defaultValue={s.start} style={{ width: 96 }}
                        onBlur={(e) => e.target.value && edit(s.id, { start: e.target.value })} />
                    </td>
                    <td className="num">
                      <input type="number" min={10} step={5} className="score" value={s.minutes}
                        onChange={(e) => edit(s.id, { minutes: Math.max(10, +e.target.value) })} />
                    </td>
                    <td>
                      <input type="text" defaultValue={s.rink} style={{ width: 110 }}
                        onBlur={(e) => edit(s.id, { rink: e.target.value.trim() || s.rink })} />
                    </td>
                    <td>
                      <select value={s.use} aria-label={`${s.date} ${fmtTime(s.start)} use`}
                        onChange={(e) => changeUse(s, e.target.value as SlotUse)}>
                        {USES.map((u) => <option key={u.v} value={u.v} title={u.hint}>{u.label}</option>)}
                      </select>
                      {isRepurposed(s) && (
                        <button className="pill moved" title={s.repurposeNote
                          || `Booked as ${s.bookedUse}. Click to put it back.`}
                          onClick={() => onChange(revertSlot(season, s.id))}>
                          was {s.bookedUse}
                        </button>
                      )}
                    </td>
                    <td>
                      <select value={s.ownerDivisionId ?? ''} aria-label={`${s.date} ${fmtTime(s.start)} reserved for`}
                        onChange={(e) => edit(s.id, { ownerDivisionId: e.target.value || null })}>
                        <option value="">Anyone</option>
                        {season.divisions.map((d) => <option key={d.id} value={d.id}>{d.name}</option>)}
                      </select>
                      {s.ownerDivisionId && (
                        <select value={s.ownerPolicy} style={{ marginLeft: 4 }}
                          aria-label={`${s.date} ${fmtTime(s.start)} policy`}
                          onChange={(e) => edit(s.id, { ownerPolicy: e.target.value as OwnerPolicy })}>
                          <option value="priority">first, then open</option>
                          <option value="exclusive">only</option>
                        </select>
                      )}
                    </td>
                    <td className="num">
                      <input type="number" min={0} max={4} className="score" value={s.capacity}
                        aria-label={`${s.date} ${fmtTime(s.start)} games at once`}
                        onChange={(e) => edit(s.id, { capacity: Math.max(0, Math.min(4, +e.target.value)) })} />
                      {s.capacity === 0 && (() => {
                        const d = season.divisions.find((x) => x.id === s.ownerDivisionId);
                        return (
                          <span className="muted" style={{ marginLeft: 4, fontSize: 'var(--t-xs)' }}
                            title={d ? `${FORMAT_LABEL[d.iceFormat]} for ${d.name}`
                              : 'Set by whichever division plays on it'}>
                            {d ? slotHolds(s, d) : 'auto'}
                          </span>
                        );
                      })()}
                    </td>
                    <td>
                      {n === 0 ? <span className="muted">free</span>
                        : n > slotHolds(s, season.divisions.find((d) => d.id === s.ownerDivisionId))
                          && s.use === 'game'
                          ? <span className="flag err">
                            over by {n - slotHolds(s, season.divisions.find((d) => d.id === s.ownerDivisionId))}
                          </span>
                        : <span className="flag ok">{n}</span>}
                    </td>
                    <td><button className="btn line" onClick={() => remove(s.id)}>Remove</button></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </>
  );
}

import { useMemo, useState } from 'react';
import type { Season, Game, LeagueManifest } from '@league/core';
import {
  GAME_USES, PLAYOFF_TYPES, REASON_LABELS, describeMove, fmtDate, fmtDay, fmtTime,
  gameWhen, placementOf, slotHolds,
  validateSeason, type ChangeReason,
} from '@league/core';
import { names } from '../lib/names';

/**
 * Editing one game. Every change is validated against the whole season before
 * it is offered, so a move that would break a rule says so before you take it.
 */
export function GameEditor(
  { season, manifest, game, onApply, onClose }:
  { season: Season; manifest: LeagueManifest; game: Game;
    onApply: (s: Season) => void; onClose: () => void },
) {
  const [mode, setMode] = useState<'home' | 'away'>(game.away ? 'away' : 'home');
  const nameOf = names(season);
  const [facility, setFacility] = useState(game.away?.facility ?? '');
  const [awayDate, setAwayDate] = useState(game.away?.date ?? '');
  const [awayStart, setAwayStart] = useState(game.away?.start ?? '19:00');
  const [awayMins, setAwayMins] = useState(game.away?.minutes ?? 60);
  const [reason, setReason] = useState<ChangeReason>('rink-conflict');
  const [note, setNote] = useState('');

  const slotById = useMemo(() => new Map(season.slots.map((s) => [s.id, s])), [season]);
  const name = useMemo(() => new Map(season.teams.map((t) => [t.id, t.name])), [season]);
  const taken = useMemo(() => {
    const m = new Map<string, number>();
    for (const g of season.games) if (g.slotId) m.set(g.slotId, (m.get(g.slotId) ?? 0) + 1);
    for (const p of season.practices) if (p.teamIds.length) m.set(p.slotId, (m.get(p.slotId) ?? 0) + 1);
    return m;
  }, [season]);

  const apply = (patch: Partial<Game>): Season => ({
    ...season,
    games: season.games.map((g) => (g.id === game.id ? { ...g, ...patch } : g)),
  });

  /**
   * Applying a move also records it. Overwriting where a game used to be, with
   * no trace, is how "it changed and nobody knows why" happens.
   */
  const commit = (next: Season) => {
    const before = new Map(season.slots.map((s) => [s.id, s]));
    const after = new Map(next.slots.map((s) => [s.id, s]));
    const changes = [...next.changes];
    for (const g of next.games) {
      const was = season.games.find((x) => x.id === g.id);
      if (!was) continue;
      const c = describeMove(g.id, placementOf(was, before), placementOf(g, after), reason, note.trim());
      if (c) changes.push(c);
    }
    onApply({ ...next, changes });
    setNote('');
  };

  /** Errors this change would introduce that do not already exist. */
  const newErrors = (next: Season): string[] => {
    const before = new Set(validateSeason(season, manifest)
      .violations.filter((v) => v.severity === 'error').map((v) => v.code + v.message));
    return validateSeason(next, manifest).violations
      .filter((v) => v.severity === 'error' && !before.has(v.code + v.message))
      .map((v) => v.message);
  };

  /** Trade places with the game already sitting in that slot. */
  const swapWith = (other: Game): Season => ({
    ...season,
    games: season.games.map((g) =>
      g.id === game.id ? { ...g, slotId: other.slotId, away: null }
      : g.id === other.id ? { ...other, slotId: game.slotId, away: null }
      : g),
  });

  // Every game slot, and what it would cost to go there. A full slot is not a
  // dead end: on a tight schedule the only useful move is a straight swap.
  const options = useMemo(() => season.slots
    .filter((s) => (PLAYOFF_TYPES.has(game.type) ? GAME_USES.has(s.use) : s.use === 'game'))
    .map((s) => {
      const current = s.id === game.slotId;
      const occupied = (taken.get(s.id) ?? 0) - (current ? 1 : 0);
      const div = season.divisions.find((d) => d.id === game.divisionId);
      const full = occupied >= slotHolds(s, div);
      const sitting = season.games.find((g) => g.slotId === s.id && g.id !== game.id);
      return {
        slot: s, current, occupied, full, sitting,
        problems: current ? [] : full ? [] : newErrors(apply({ slotId: s.id, away: null })),
        swapProblems: current || !full || !sitting || !game.slotId ? ['no swap possible']
          : sitting.locked ? [`${label(sitting)} is locked.`]
          : newErrors(swapWith(sitting)),
      };
    }), [season, game, taken]);

  function label(g: Game): string {
    return `${name.get(g.homeTeamId ?? '') ?? g.homeLabel} v ${name.get(g.awayTeamId ?? '') ?? g.awayLabel}`;
  }

  const free = options.filter((o) => !o.full && !o.problems.length && !o.current);
  const swappable = options.filter((o) => o.full && !o.swapProblems.length);
  const when = gameWhen(game, slotById);

  const awayProblems = (): string[] => {
    if (!facility.trim()) return ['Name the rink this game is played at.'];
    if (!/^\d{4}-\d{2}-\d{2}$/.test(awayDate)) return ['Give the date as YYYY-MM-DD.'];
    if (!/^([01]\d|2[0-3]):[0-5]\d$/.test(awayStart)) return ['Give the time as HH:MM, 24 hour.'];
    return newErrors(apply({
      slotId: null,
      away: { facility: facility.trim(), city: '', date: awayDate, start: awayStart, minutes: awayMins },
    }));
  };

  return (
    <div className="editor">
      <div className="editor-head">
        <div>
          <strong>{name.get(game.homeTeamId ?? '') ?? game.homeLabel}</strong>
          {' v '}
          <strong>{name.get(game.awayTeamId ?? '') ?? game.awayLabel}</strong>
          <span className="chip div" style={{ marginLeft: 8 }}>{nameOf.division(game.divisionId)}</span>
        </div>
        <button className="btn line" onClick={onClose}>Close</button>
      </div>

      <p className="lede" style={{ marginBottom: 12 }}>
        {when
          ? `Currently ${when.away ? 'away at' : 'at'} ${when.rink}, ${fmtDay(when.date)} ${fmtDate(when.date)} at ${fmtTime(when.start)}.`
          : 'This game has no date yet.'}
      </p>

      <div className="row">
        <div className="field">
          <label htmlFor="why">Why it is moving</label>
          <select id="why" value={reason} onChange={(e) => setReason(e.target.value as ChangeReason)}>
            {(Object.keys(REASON_LABELS) as ChangeReason[]).map((k) =>
              <option key={k} value={k}>{REASON_LABELS[k]}</option>)}
          </select>
        </div>
        <div className="field" style={{ flex: 1, minWidth: 220 }}>
          <label htmlFor="note">Note for the record</label>
          <input id="note" type="text" value={note} placeholder="Optional"
            onChange={(e) => setNote(e.target.value)} />
        </div>
      </div>

      <div className="row">
        <label className="toggle">
          <input type="checkbox" checked={game.locked}
            onChange={(e) => onApply(apply({ locked: e.target.checked }))} />
          Lock this game so generating leaves it alone
        </label>
      </div>

      <div className="row">
        <button className={`btn ${mode === 'home' ? 'go' : 'line'}`}
          aria-pressed={mode === 'home'} onClick={() => setMode('home')}>Our ice</button>
        <button className={`btn ${mode === 'away' ? 'go' : 'line'}`}
          aria-pressed={mode === 'away'} onClick={() => setMode('away')}>Away at another rink</button>
      </div>

      {mode === 'home' ? (
        <>
          <p className="lede" style={{ marginBottom: 10 }}>
            {free.length} empty {free.length === 1 ? 'slot takes' : 'slots take'} this game, and{' '}
            {swappable.length} occupied {swappable.length === 1 ? 'slot can' : 'slots can'} trade
            places with it. Anything else says why not.
          </p>
          <div className="scroll-y">
            <table>
              <thead>
                <tr><th>Date</th><th>Day</th><th>Time</th><th>Rink</th><th>Status</th><th /></tr>
              </thead>
              <tbody>
                {options.map((o) => (
                  <tr key={o.slot.id} className={o.current ? 'is-current' : ''}>
                    <td>{fmtDate(o.slot.date)}</td>
                    <td className="muted">{fmtDay(o.slot.date)}</td>
                    <td>{fmtTime(o.slot.start)}</td>
                    <td>{o.slot.rink}</td>
                    <td>
                      {o.current ? <span className="flag ok">here now</span>
                        : o.full
                          ? (o.swapProblems.length
                              ? <span className="flag err">{o.swapProblems[0]}</span>
                              : <span className="muted">holds {label(o.sitting!)}</span>)
                          : o.problems.length
                            ? <span className="flag err">{o.problems[0]}</span>
                            : <span className="flag ok">empty</span>}
                    </td>
                    <td>
                      {o.current ? null : o.full ? (
                        <button className="btn line" disabled={o.swapProblems.length > 0}
                          onClick={() => { commit(swapWith(o.sitting!)); onClose(); }}>
                          Swap
                        </button>
                      ) : (
                        <button className="btn line" disabled={o.problems.length > 0}
                          onClick={() => { commit(apply({ slotId: o.slot.id, away: null })); onClose(); }}>
                          Move here
                        </button>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      ) : (
        <AwayForm
          facility={facility} setFacility={setFacility}
          date={awayDate} setDate={setAwayDate}
          start={awayStart} setStart={setAwayStart}
          minutes={awayMins} setMinutes={setAwayMins}
          problems={awayProblems()}
          onSave={() => {
            commit(apply({
              slotId: null,
              away: { facility: facility.trim(), city: '', date: awayDate, start: awayStart, minutes: awayMins },
            }));
            onClose();
          }}
        />
      )}
    </div>
  );
}

function AwayForm(p: {
  facility: string; setFacility: (v: string) => void;
  date: string; setDate: (v: string) => void;
  start: string; setStart: (v: string) => void;
  minutes: number; setMinutes: (v: number) => void;
  problems: string[]; onSave: () => void;
}) {
  return (
    <>
      <p className="lede" style={{ marginBottom: 12 }}>
        An away game uses none of our ice, but both teams still count it and stay busy that day.
      </p>
      <div className="row">
        <div className="field">
          <label htmlFor="fac">Rink</label>
          <input id="fac" type="text" value={p.facility} style={{ width: 220 }}
            placeholder="Codey Arena" onChange={(e) => p.setFacility(e.target.value)} />
        </div>
        <div className="field">
          <label htmlFor="ad">Date</label>
          <input id="ad" type="date" value={p.date} style={{ width: 150 }}
            onChange={(e) => p.setDate(e.target.value)} />
        </div>
        <div className="field">
          <label htmlFor="as">Start</label>
          {/* A time input, not text: the browser shows it as 6:30 PM and still
              hands back 18:30, so nobody types a 24-hour clock by hand. */}
          <input id="as" type="time" value={p.start} style={{ width: 110 }}
            onChange={(e) => p.setStart(e.target.value)} />
        </div>
        <div className="field">
          <label htmlFor="am">Minutes</label>
          <input id="am" type="number" value={p.minutes} style={{ width: 90 }}
            onChange={(e) => p.setMinutes(Math.max(1, +e.target.value))} />
        </div>
      </div>
      {p.problems.length > 0 && (
        <ul className="problems">{p.problems.map((x, i) => <li key={i}>{x}</li>)}</ul>
      )}
      <button className="btn go" onClick={p.onSave} disabled={p.problems.length > 0}>
        Save as an away game
      </button>
    </>
  );
}

import type { Season, LeagueManifest, ValidationResult } from '@league/core';
import {
  bracketProgress, fmtDateYear, listDays, playoffGames, readiness, titleCase,
} from '@league/core';
import { weekBars } from '../lib/strip';

export function Overview(
  { season, manifest, result }:
  { season: Season; manifest: LeagueManifest; result: ValidationResult },
) {
  const bars = weekBars(season, manifest.week.startsOn);
  if (!season.slots.length) {
    return (
      <>
        <h2>{season.name}</h2>
        <p className="lede">
          Nothing to show yet. A season needs ice and teams before it can be scheduled.
        </p>
        <div className="empty">
          <p>Start on <strong>Setup</strong> to set the dates and divisions, then
            <strong> Ice</strong> to import a Finnly export or add slots, then
            <strong> Teams</strong>.</p>
        </div>
      </>
    );
  }
  const peak = Math.max(1, ...bars.map((b) => b.slots));
  const ready = readiness(season, manifest, result);
  const bracket = playoffGames(season);
  const champions = season.divisions
    .map((d) => ({ d, champion: bracketProgress(season, d.id).champion }))
    .filter((x) => x.champion);
  const used = season.games.filter((g) => g.slotId).length;
  const booked = season.slots.length;
  const free = booked - new Set(season.games.map((g) => g.slotId)).size;

  return (
    <>
      <h2>{fmtDateYear(season.startDate)} to {fmtDateYear(season.endDate)}</h2>
      <p className="lede">
        {season.teams.length} teams across {season.divisions.length} divisions.
        {' '}{booked} slots booked, {used} games placed, {free} slots still free.
        {bracket.length ? ` ${bracket.length} of those are bracket games.` : ''}
      </p>
      {champions.length > 0 && (
        <p className="notice">
          {champions.map(({ d, champion }, i) => (
            <span key={d.id}>{i ? ' · ' : ''}<strong>{champion}</strong> win {d.name}</span>
          ))}
        </p>
      )}

      <section className="strip" aria-label="Ice booked and used, week by week">
        <div className="track">
          {bars.map((b) => (
            <div className="wk" key={b.week} title={`Week of ${b.week}: ${b.games} of ${b.slots} slots used`}>
              <div className="cap" style={{ height: `${(b.slots / peak) * 100}%` }}>
                <span className={b.games ? 'fill' : 'fill empty'}
                  style={{ height: `${b.slots ? (b.games / b.slots) * 100 : 0}%` }} />
              </div>
            </div>
          ))}
        </div>
        <div className="axis">{bars.map((b) => <span key={b.week}>{b.label}</span>)}</div>
        <div className="legend">
          <span><i style={{ background: 'var(--blueline)' }} />Games placed</span>
          <span><i style={{ background: 'var(--shadow)', outline: '1px solid var(--shadow-deep)' }} />Ice booked and free</span>
        </div>
      </section>

      <section className="panel ready">
