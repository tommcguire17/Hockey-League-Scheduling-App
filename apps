import type { Season } from '@league/core';

/**
 * Ids are for the machine. Names are for people.
 *
 * A division's id is whatever the import happened to produce — "D1", "div-3",
 * a Finnly code — and it has to stay stable, because every game, slot and ice
 * rule points at it. The name is what the rink calls the thing: "8U". Tom
 * renamed a division to 8U and the console went on saying D1, because seven
 * different places reached for `divisionId` when they wanted `name`, and each
 * of them looked correct on its own.
 *
 * So: nothing renders an id. Every view labels a division from here, and one
 * renamed on the Setup screen is renamed on all of them. The fallback is the
 * id itself, which only shows up when a game points at something that has
 * been deleted — and then seeing the dangling id is exactly what you want.
 */
export interface Names {
  division: (id: string | null | undefined) => string;
  team: (id: string | null | undefined) => string;
}

export function names(season: Season): Names {
  const div = new Map(season.divisions.map((d) => [d.id, d.name]));
  const team = new Map(season.teams.map((t) => [t.id, t.name]));
  return {
    division: (id) => (id ? div.get(id) ?? id : ''),
    team: (id) => (id ? team.get(id) ?? id : ''),
  };
}

/** Reading and writing files from the browser. No server, nothing uploaded. */

export function readFile(accept: string): Promise<{ name: string; text: string } | null> {
  return new Promise((resolve) => {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = accept;
    input.onchange = () => {
      const f = input.files?.[0];
      if (!f) return resolve(null);
      const r = new FileReader();
      r.onload = () => resolve({ name: f.name, text: String(r.result) });
      r.onerror = () => resolve(null);
      r.readAsText(f);
    };
    input.click();
  });
}

export function download(name: string, text: string, type = 'text/plain'): void {
  const url = URL.createObjectURL(new Blob([text], { type: `${type};charset=utf-8` }));
  const a = document.createElement('a');
  a.href = url; a.download = name;
  a.click();
  setTimeout(() => URL.revokeObjectURL(url), 1000);
}

import type { Season } from '@league/core';
import { weekKey } from '@league/core';

export interface WeekBar { week: string; label: string; slots: number; games: number; }

/** Ice booked against ice used, week by week. The shape of the season. */
export function weekBars(season: Season, startsOn: Parameters<typeof weekKey>[1]): WeekBar[] {
  const slotById = new Map(season.slots.map((s) => [s.id, s]));
  const m = new Map<string, WeekBar>();
  const touch = (date: string): WeekBar => {
    const k = weekKey(date, startsOn);
    const [, mm, dd] = k.split('-') as [string, string, string];
    return m.get(k) ?? m.set(k, { week: k, label: `${+mm}/${+dd}`, slots: 0, games: 0 }).get(k)!;
  };
  for (const s of season.slots) touch(s.date).slots++;
  for (const g of season.games) {
    const s = g.slotId ? slotById.get(g.slotId) : undefined;
    if (s) touch(s.date).games++;
  }
  return [...m.values()].sort((a, b) => a.week.localeCompare(b.week));
}

import { useEffect, useRef, type RefObject } from 'react';

/**
 * Finding the thing that actually scrolls.
 *
 * The window does not scroll in this console: the layout is a fixed header, a
 * fixed rail and a `.main` that carries `overflow: auto`. So `window.scrollTo`
 * is a no-op here and `scrollIntoView` has to be aimed at an element inside
 * that pane. Anything that wants to move the view has to find the real
 * scroller rather than assume it is the page, which is why this is one helper
 * instead of a call site each.
 */
export function scrollParent(el: Element | null): Element | null {
  let node: Element | null = el?.parentElement ?? null;
  while (node) {
    const style = getComputedStyle(node);
    const scrolls = /(auto|scroll|overlay)/.test(style.overflowY);
    if (scrolls && node.scrollHeight > node.clientHeight + 1) return node;
    node = node.parentElement;
  }
  return document.scrollingElement;
}

/**
 * Brings a panel into view when it opens.
 *
 * The editors on Schedule and Ice are rendered above the list they belong to,
 * which is right — an editor below a 200-row table would be off the bottom of
 * the world. But clicking Edit on the last row of that table then changes
 * something a full screen above where you are looking, and nothing tells you:
 * Tom's report was that the editing block "pops up at the top of the page" and
 * he could not see it. So opening one scrolls to it.
 *
 * `open` keyed rather than a plain boolean, so clicking Edit on a different
 * row of an already-open editor scrolls again. Smooth where the browser allows
 * it, instant where the person has asked for reduced motion.
 */
export function useRevealOnOpen(
  ref: RefObject<HTMLElement | null>, open: string | boolean | null,
): void {
  const last = useRef<string | boolean | null>(null);
  useEffect(() => {
    if (!open || open === last.current) { last.current = open; return; }
    last.current = open;
    const el = ref.current;
    if (!el) return;
    const calm = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
    // A frame's grace so the panel has been laid out and has a real height.
    const id = requestAnimationFrame(() => {
      el.scrollIntoView({ behavior: calm ? 'auto' : 'smooth', block: 'nearest' });
      // Move keyboard focus too, so the person's next Tab starts in the panel
      // rather than back in the table they were just in.
      const focusable = el.querySelector<HTMLElement>(
        'input, select, textarea, button, [tabindex]:not([tabindex="-1"])');
      focusable?.focus({ preventScroll: true });
    });
    return () => cancelAnimationFrame(id);
  }, [ref, open]);
}

import { useEffect, useState } from 'react';
import { scrollParent } from './scroll';

/**
 * Back to the top of whichever tab you are on.
 *
 * Every tab in this console is a long list — 120 slots, 130 games, a season of
 * results — and the controls that act on the list are at the top of it. So the
 * bottom of a list is a dead end: the only way back is a long scroll or a
 * keyboard shortcut, and neither is obvious on a phone at the rink.
 *
 * Mounted once in the shell rather than per tab, because there is one scroll
 * pane and one of these is enough. It stays out of the way until there is
 * something to go back to: hidden at the top, and hidden entirely when the
 * content is too short to scroll.
 */
export function BackToTop({ containerRef }: {
  containerRef: { current: HTMLElement | null };
}) {
  const [show, setShow] = useState(false);

  useEffect(() => {
    const el = containerRef.current;
    if (!el) return;
    // The pane itself scrolls, but keep working if the layout ever changes to
    // scroll the page instead.
    const target: Element = el.scrollHeight > el.clientHeight + 1
      ? el : scrollParent(el) ?? el;
    const read = () => setShow(target.scrollTop > 400);
    read();
    target.addEventListener('scroll', read, { passive: true });
    // A tab switch replaces the content under the same pane, which is not a
    // scroll event; watch the size so the button hides on a short tab.
    const ro = new ResizeObserver(read);
    ro.observe(target);
    return () => { target.removeEventListener('scroll', read); ro.disconnect(); };
  }, [containerRef]);

  const up = () => {
    const el = containerRef.current;
    if (!el) return;
    const target: Element = el.scrollHeight > el.clientHeight + 1
      ? el : scrollParent(el) ?? el;
    const calm = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
    target.scrollTo({ top: 0, behavior: calm ? 'auto' : 'smooth' });
  };

  return (
    <button type="button" className={`to-top${show ? ' on' : ''}`} onClick={up}
      aria-hidden={!show} tabIndex={show ? 0 : -1}
      title="Back to the top of this tab">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <path d="M12 5l-7 7h4v7h6v-7h4z" fill="currentColor" />
      </svg>
      <span>Top</span>
    </button>
  );
}

