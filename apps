  };
  return map[code] ?? code.toLowerCase().replace(/_/g, ' ');
}

import type { Season, LeagueManifest, IceFormat } from '@league/core';
import { Division, MANIFESTS } from '@league/core';
import { importBlackouts } from '@league/io';
import { readFile } from '../lib/files';

/** The season's own settings: who it is, when it runs, and its divisions. */
export function Setup(
  { season, manifest, onChange }:
  { season: Season; manifest: LeagueManifest; onChange: (s: Season) => void },
) {
  const set = (patch: Partial<Season>) => onChange({ ...season, ...patch });

  const setDivision = (id: string, patch: Partial<Division>) =>
    set({ divisions: season.divisions.map((d) => (d.id === id ? { ...d, ...patch } : d)) });

  /**
   * Crossover is a relationship, so it is written on both divisions. Setting
   * it one-way would read as done while only half the pair knew about it.
   */
  const toggleCrossover = (aId: string, bId: string) => {
    const a = season.divisions.find((d) => d.id === aId);
    const on = !!a && !a.playsAcross.includes(bId);
    set({
      divisions: season.divisions.map((d) => {
        if (d.id !== aId && d.id !== bId) return d;
        const other = d.id === aId ? bId : aId;
        const next = on
          ? [...new Set([...d.playsAcross, other])]
          : d.playsAcross.filter((x) => x !== other);
        // Turning the last partner off turns the count off with it.
        return { ...d, playsAcross: next, crossGamesPerTeam: next.length ? d.crossGamesPerTeam : 0 };
      }),
    });
  };

  const addDivision = () => {
    let n = season.divisions.length + 1;
    while (season.divisions.some((d) => d.id === `D${n}`)) n++;
    set({ divisions: [...season.divisions, Division.parse({ id: `D${n}`, name: `Division ${n}` })] });
  };

  const removeDivision = (id: string) => {
    const teams = season.teams.filter((t) => t.divisionId === id);
    if (teams.length && !confirm(
      `${teams.length} teams are in this division. Remove it and them?`)) return;
    set({
      divisions: season.divisions.filter((d) => d.id !== id),
      teams: season.teams.filter((t) => t.divisionId !== id),
      games: season.games.filter((g) => g.divisionId !== id),
      practices: season.practices.filter((p) => p.divisionId !== id),
    });
  };

  async function importBlackoutCsv() {
    const f = await readFile('.csv,text/csv');
    if (!f) return;
    try {
      const { dates } = importBlackouts(f.text);
      set({ blackoutDates: [...new Set([...season.blackoutDates, ...dates])].sort() });
    } catch (e) {
      alert(e instanceof Error ? e.message : String(e));
    }
  }

  return (
    <>
      <h2>Setup</h2>
      <p className="lede">
        The season's name, dates and divisions. Rules come from the league and are shown on
        Overview.
      </p>

      <div className="panel" style={{ maxWidth: 620 }}>
        <h3>This season</h3>
        <div className="field" style={{ marginBottom: 10 }}>
          <label htmlFor="sn">Name</label>
          <input id="sn" type="text" defaultValue={season.name}
            onBlur={(e) => set({ name: e.target.value.trim() || season.name })} />
        </div>
        <div className="row">
          <div className="field">
            <label htmlFor="sl">League</label>
            <select id="sl" value={season.leagueId} onChange={(e) => set({ leagueId: e.target.value })}>
              {Object.values(MANIFESTS).map((m) => <option key={m.id} value={m.id}>{m.name}</option>)}
            </select>
          </div>
          <div className="field">
            <label htmlFor="s1">First day</label>
            <input id="s1" type="date" defaultValue={season.startDate}
              onBlur={(e) => e.target.value && set({ startDate: e.target.value })} />
          </div>
          <div className="field">
            <label htmlFor="s2">Last day</label>
            <input id="s2" type="date" defaultValue={season.endDate}
              onBlur={(e) => e.target.value && set({ endDate: e.target.value })} />
          </div>
        </div>
        <div className="row" style={{ marginBottom: 0 }}>
          <div className="field" style={{ flex: 1 }}>
            <label htmlFor="s3">Venue</label>
            <input id="s3" type="text" defaultValue={season.venue}
              onBlur={(e) => set({ venue: e.target.value.trim() })} />
          </div>
          <div className="field">
            <label htmlFor="s4">City</label>
            <input id="s4" type="text" defaultValue={season.city}
              onBlur={(e) => set({ city: e.target.value.trim() })} />
          </div>
        </div>
      </div>

      <div className="panel">
        <h3>Divisions</h3>
        <p className="lede" style={{ marginBottom: 10 }}>
          Leave a target blank to use the league default
          ({manifest.scheduling.defaultGamesPerTeam} games
          {manifest.capabilities.practices
            ? `, ${manifest.scheduling.defaultPracticesPerTeam} practices` : ''}).
        </p>
        {season.divisions.length === 0 ? (
          <p className="lede">No divisions yet. Add one, or import a team list on the Teams tab —
            divisions are created from it automatically.</p>
        ) : (
          <table>
            <thead>
              <tr><th>Name</th><th className="num">Teams</th><th className="num">Games each</th>
                {manifest.capabilities.practices && <th className="num">Practices each</th>}
                <th className="num" title="Sessions this level needs before it plays. Zero means it does not run evaluations; tick it up when signups need more than one sheet.">
                  Evaluations
                </th>
                <th title="How this level splits a sheet. Every team in the division plays the same way.">
                  Ice format
                </th>
                <th title="Divisions this one may also play, and how many of its games are against them. Both divisions must split the ice the same way.">
                  Crosses over with
                </th>
                <th className="num">Playoff teams</th><th /></tr>
            </thead>
            <tbody>
              {season.divisions.map((d) => (
                <tr key={d.id}>
                  <td>
                    <input type="text" defaultValue={d.name} style={{ width: 160 }}
                      aria-label={`Division ${d.name} name`}
                      onBlur={(e) => setDivision(d.id, { name: e.target.value.trim() || d.name })} />
                  </td>
                  <td className="num">{season.teams.filter((t) => t.divisionId === d.id).length}</td>
                  <td className="num">
                    <input type="number" min={0} className="score" value={d.gamesPerTeam ?? ''}
                      placeholder={String(manifest.scheduling.defaultGamesPerTeam)}
                      onChange={(e) => setDivision(d.id, {
                        gamesPerTeam: e.target.value === '' ? null : Math.max(0, +e.target.value) })} />
                  </td>
                  {manifest.capabilities.practices && (
                    <td className="num">
                      <input type="number" min={0} className="score" value={d.practicesPerTeam ?? ''}
                        placeholder={String(manifest.scheduling.defaultPracticesPerTeam)}
                        onChange={(e) => setDivision(d.id, {
                          practicesPerTeam: e.target.value === '' ? null : Math.max(0, +e.target.value) })} />
                    </td>
                  )}
                  <td className="num">
                    <input type="number" min={0} max={6} step={1} className="score"
                      value={d.evaluationSessions} aria-label={`${d.name} evaluation sessions`}
                      onChange={(e) => setDivision(d.id, {
                        evaluationSessions: Math.max(0, Math.min(6, +e.target.value)) })} />
                  </td>
                  <td>
                    <select value={d.iceFormat} aria-label={`${d.name} ice format`}
                      onChange={(e) => setDivision(d.id, { iceFormat: e.target.value as IceFormat })}>
                      <option value="full">Full ice — 1 game</option>
                      <option value="half">Half ice — 2 games</option>
                      <option value="cross">Cross ice — 3 games</option>
                    </select>
                  </td>
                  <td>
                    <div className="crossers">
                      {season.divisions.filter((x) => x.id !== d.id).map((x) => {
                        const on = d.playsAcross.includes(x.id);
                        const clash = x.iceFormat !== d.iceFormat;
                        return (
                          <button key={x.id} type="button" className="pill cross"
                            aria-pressed={on} disabled={clash}
                            title={clash
                              ? `${x.name} plays ${x.iceFormat} ice and ${d.name} plays ${d.iceFormat} ice`
                              : `${d.name} and ${x.name} may play each other`}
                            onClick={() => toggleCrossover(d.id, x.id)}>
                            {x.name}
                          </button>
                        );
                      })}
                      {season.divisions.length < 2 && <span className="muted">—</span>}
                    </div>
                    {d.playsAcross.length > 0 && (
                      <label className="crossnum">
                        <input type="number" min={0} max={d.gamesPerTeam
                          ?? manifest.scheduling.defaultGamesPerTeam}
                          className="score" value={d.crossGamesPerTeam}
                          aria-label={`${d.name} crossover games`}
                          onChange={(e) => setDivision(d.id, {
                            crossGamesPerTeam: Math.max(0, +e.target.value) })} />
                        <span className="muted">of its games</span>
                      </label>
                    )}
                  </td>
                  <td className="num">
                    <input type="number" min={0} className="score" value={d.playoffTeams}
                      onChange={(e) => setDivision(d.id, { playoffTeams: Math.max(0, +e.target.value) })} />
                  </td>
                  <td>
                    <button className="btn line" onClick={() => removeDivision(d.id)}>Remove</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
        <div className="row" style={{ marginTop: 12, marginBottom: 0 }}>
          <button className="btn line" onClick={addDivision}>Add division</button>
        </div>
      </div>

      <div className="panel">
        <h3>League blackout dates</h3>
        <p className="lede" style={{ marginBottom: 10 }}>
          Dates nobody plays: school breaks, holidays. The generator works around them.
          Comma separated, YYYY-MM-DD.
        </p>
        <input type="text" style={{ width: '100%', maxWidth: 680 }}
          placeholder="2026-12-24, 2026-12-25"
          defaultValue={season.blackoutDates.join(', ')}
          onBlur={(e) => set({
            blackoutDates: e.target.value.split(',').map((x) => x.trim()).filter(Boolean).sort() })} />
        <div className="row" style={{ marginTop: 12, marginBottom: 0 }}>
          <button className="btn line" onClick={importBlackoutCsv}>Import blackout dates from CSV</button>
        </div>
      </div>
    </>
  );
}

import { useMemo, useRef, useState } from 'react';
import type {
  Season, LeagueManifest, Game, Practice, Slot, RepurposeSuggestion,
} from '@league/core';
import {
  applySuggestions, evaluationReadiness, evaluationStatus, fmtDate, fmtDay, fmtTime,
  gameWhen,
} from '@league/core';
import {
  generateSchedule, assignPractices, type GenerateReport, type PracticeReport,
} from '@league/engine';
import { GameEditor } from './GameEditor';
import { names } from '../lib/names';
import { useRevealOnOpen } from '../lib/scroll';

/**
 * Everything that happens on the ice, in one list.
 *
 * It used to show games only, which made a season look half-empty: the
 * practices were not there to show, and the booked ice sitting idle was
 * invisible exactly when you most want to see it. Now every kind of row is
 * here and the Show filter takes out what you are not looking at.
 */

type Kind = 'game' | 'practice' | 'evaluation' | 'free';

interface Row {
  key: string;
  kind: Kind;
  date: string;
  start: string;
  rink: string;
  minutes: number;
  divisionId: string;
  teamIds: string[];
  away: boolean;
  game?: Game;
  practice?: Practice;
  slot?: Slot;
}

const SHOW: { v: Kind | 'all' | 'booked'; label: string }[] = [
  { v: 'booked', label: 'Everything booked' },
  { v: 'all', label: 'Everything, including free ice' },
  { v: 'game', label: 'Games only' },
  { v: 'practice', label: 'Practices only' },
  { v: 'evaluation', label: 'Evaluations only' },
  { v: 'free', label: 'Unused ice only' },
];

export function Schedule(
  { season, manifest, onChange, fresh }:
  { season: Season; manifest: LeagueManifest; onChange: (s: Season) => void; fresh: boolean },
) {
  const [team, setTeam] = useState('all');
  const nameOf = names(season);
  const [div, setDiv] = useState('all');
  const [show, setShow] = useState<Kind | 'all' | 'booked'>('booked');
  const [seed, setSeed] = useState(20262027);
  const [busy, setBusy] = useState(false);
  const [report, setReport] = useState<GenerateReport | null>(null);
  const [practiceReport, setPracticeReport] = useState<PracticeReport | null>(null);
  const [editing, setEditing] = useState<string | null>(null);
  /**
   * The editor is rendered above the schedule table, so clicking Edit on the
   * last of 130 rows used to change something a screen and a half away with
   * nothing to say so. Opening it scrolls to it.
   */
  const editorRef = useRef<HTMLDivElement | null>(null);
  useRevealOnOpen(editorRef, editing);
  const [suggestions, setSuggestions] = useState<RepurposeSuggestion[]>([]);
  const [picked, setPicked] = useState<Set<string>>(new Set());

  const slot = useMemo(() => new Map(season.slots.map((s) => [s.id, s])), [season]);
  const name = useMemo(() => new Map(season.teams.map((t) => [t.id, t.name])), [season]);

  /**
   * Teams in the chosen division, and nothing else. Offering all sixteen
   * teams after picking 8U is a list of fourteen wrong answers.
   */
  const teamsForDiv = useMemo(
    () => season.teams.filter((t) => div === 'all' || t.divisionId === div),
    [season, div]);

  /** Changing the division drops a team filter that no longer belongs to it. */
  function pickDivision(next: string) {
    setDiv(next);
    if (team !== 'all' && next !== 'all'
      && !season.teams.some((t) => t.id === team && t.divisionId === next)) setTeam('all');
  }

  const rows = useMemo<Row[]>(() => {
    const out: Row[] = [];
    const taken = new Map<string, number>();

    for (const g of season.games) {
      const w = gameWhen(g, slot);
      if (!w) continue;
      if (g.slotId) taken.set(g.slotId, (taken.get(g.slotId) ?? 0) + 1);
      out.push({
        key: `g:${g.id}`, kind: 'game', date: w.date, start: w.start, rink: w.rink,
        minutes: w.minutes, divisionId: g.divisionId,
        teamIds: [g.homeTeamId, g.awayTeamId].filter(Boolean) as string[],
        away: w.away, game: g, slot: g.slotId ? slot.get(g.slotId) : undefined,
      });
    }

    for (const p of season.practices) {
      const s = slot.get(p.slotId);
      if (!s) continue;
      taken.set(s.id, (taken.get(s.id) ?? 0) + 1);
      out.push({
        key: `p:${p.id}`, kind: p.kind === 'evaluation' ? 'evaluation' : 'practice',
        date: s.date, start: s.start, rink: s.rink, minutes: s.minutes,
        divisionId: p.divisionId, teamIds: p.teamIds, away: false, practice: p, slot: s,
      });
    }

    for (const s of season.slots) {
      if (taken.has(s.id) || s.use === 'unused') continue;
      out.push({
        key: `f:${s.id}`, kind: 'free', date: s.date, start: s.start, rink: s.rink,
        minutes: s.minutes, divisionId: s.ownerDivisionId ?? '', teamIds: [], away: false, slot: s,
      });
    }

    return out.sort((a, b) =>
      (a.date + a.start + a.rink).localeCompare(b.date + b.start + b.rink));
  }, [season, slot]);

  const shown = rows
    .filter((r) => (show === 'all' ? true : show === 'booked' ? r.kind !== 'free' : r.kind === show))
    .filter((r) => div === 'all' || r.divisionId === div)
    // Free ice belongs to nobody, so a team filter hides it rather than
    // pretending the slot is that team's.
    .filter((r) => team === 'all' || r.teamIds.includes(team));

  /**
   * Evaluations are the first thing a division does, and everything else
   * waits on them, so where they sit is worth showing rather than leaving
   * someone to work it out from the rows.
   */
  const evals = useMemo(() => evaluationStatus(season), [season]);
  const ready = useMemo(() => evaluationReadiness(season), [season]);
  // Only worth a panel once a division asks for evaluations, or has some.
  const showEvals = evals.some((e) => e.wanted > 0 || e.dates.length > 0);

  const counts = useMemo(() => {
    const c: Record<Kind, number> = { game: 0, practice: 0, evaluation: 0, free: 0 };
    for (const r of rows) c[r.kind]++;
    return c;
  }, [rows]);

  function run() {
    setBusy(true);
    // let the button paint before the engine blocks the thread
    setTimeout(() => {
      try {
        const { games, report: r } = generateSchedule(season, manifest, { seed });
        const withGames = { ...season, games };
        const { practices, report: pr } = assignPractices(withGames, manifest);
        setReport(r);
        setPracticeReport(pr);
        // Proposals only. Nothing is repurposed until the button below is pressed.
        const all = [...r.suggestions, ...pr.suggestions]
          .filter((s2, i, list) => list.findIndex((x) => x.slotId === s2.slotId) === i);
        setSuggestions(all);
        setPicked(new Set(all.map((s2) => s2.slotId)));
        onChange({ ...withGames, practices });
      } finally { setBusy(false); }
    }, 16);
  }

  return (
    <>
      <h2>Schedule</h2>
      <p className="lede">
        Generating replaces every game and practice in this season. The same seed always produces
        the same schedule, so change the seed to see a different one. Games that are locked, away
        or part of a bracket stay where they are.
      </p>

      <div className="row">
        <div className="field">
          <label htmlFor="seed">Seed</label>
          <input id="seed" type="number" value={seed} style={{ width: 120 }}
            onChange={(e) => setSeed(+e.target.value)} />
        </div>
        <div className="field">
          <label>&nbsp;</label>
          <button className="btn go" onClick={run} disabled={busy}>
            {busy ? 'Working…' : season.games.length ? 'Generate again' : 'Generate schedule'}
          </button>
        </div>
        <div className="field">
          <label htmlFor="show">Show</label>
          <select id="show" value={show} onChange={(e) => setShow(e.target.value as Kind)}>
            {SHOW.map((s) => <option key={s.v} value={s.v}>{s.label}</option>)}
          </select>
        </div>
        <div className="field">
          <label htmlFor="d">Division</label>
          <select id="d" value={div} onChange={(e) => pickDivision(e.target.value)}>
            <option value="all">All divisions</option>
            {season.divisions.map((x) => <option key={x.id} value={x.id}>{x.name}</option>)}
          </select>
        </div>
        <div className="field">
          <label htmlFor="t">Team</label>
          <select id="t" value={team} onChange={(e) => setTeam(e.target.value)}
            disabled={!teamsForDiv.length}>
            <option value="all">{div === 'all' ? 'All teams' : `All ${div} teams`}</option>
            {teamsForDiv.map((x) => <option key={x.id} value={x.id}>{x.name}</option>)}
          </select>
        </div>
        <div className="field"><label>&nbsp;</label><span className="muted">{shown.length} shown</span></div>
      </div>

      <p className="muted" style={{ margin: '-6px 0 16px' }}>
        {counts.game} games · {counts.practice} practices · {counts.evaluation} evaluations ·{' '}
        <strong className={counts.free ? 'flag wrn' : ''}>{counts.free} slots with nothing on them</strong>
      </p>

      {report && (
        <div className="panel">
          <h3>Last run</h3>
          <table>
            <tbody>
              {report.byDivision.map((d) => {
                const p = practiceReport?.byDivision.find((x) => x.divisionId === d.divisionId);
                return (
                  <tr key={d.divisionId}>
                    <td style={{ width: 140 }}><span className="chip div">{nameOf.division(d.divisionId)}</span></td>
                    <td>
                      {d.placed} of {d.fixtures} games placed at {d.gamesPerTeam} per team
                      {p && p.target > 0 && (
                        <>
                          {' · '}
                          <span className={p.min < p.target ? 'flag wrn' : ''}>
                            {p.min === p.max ? `${p.min}` : `${p.min}-${p.max}`} of {p.target} practices
                          </span>
                          {p.patterns.length ? ` on ${p.patterns.join(', ')}` : ''}
                        </>
                      )}
                    </td>
                  </tr>
                );
              })}
              {report.unplaced.length > 0 && (
                <tr><td colSpan={2}>
                  <span className="flag err">{report.unplaced.length} games could not be placed.</span>{' '}
                  {report.unplaced.slice(0, 3).map((u) => `${u.homeId} v ${u.awayId}`).join('; ')}
                  {report.unplaced.length > 3 ? ' …' : ''}
                  {' '}Free up ice or relax a blackout date.
                </td></tr>
              )}
              {report.playoffIce.games > 0 && (
                <tr><td>Playoff ice</td><td>
                  {report.playoffIce.dates.length > 0 ? (
                    <>
                      {report.playoffIce.dates.length} night
                      {report.playoffIce.dates.length === 1 ? '' : 's'} held back from{' '}
                      {fmtDate(report.playoffIce.dates[0]!)} for {report.playoffIce.games}{' '}
                      bracket games
                      {report.playoffIce.sufficient
                        ? <span className="flag ok" style={{ marginLeft: 8 }}>enough</span>
                        : <span className="flag wrn" style={{ marginLeft: 8 }}>not enough</span>}
                    </>
                  ) : <span className="flag wrn">no ice held back</span>}
                  {report.playoffIce.issues.map((x, i) => (
                    <div key={i} className="muted" style={{ marginTop: 4 }}>{x}</div>
                  ))}
                </td></tr>
              )}
              <tr><td>Longest repeat run</td><td>{report.longestRepeatRun} — a team meeting the same
                opponent this many times in a row</td></tr>
              {report.crossGames > 0 && (
                <tr><td>Crossover games</td><td>
                  {report.crossGames} against another division
                  {report.crossShort.length > 0 && (
                    <> — <span className="flag wrn">
                      {report.crossShort.length} team{report.crossShort.length === 1 ? '' : 's'} got
                      fewer than asked for; the divisions are different sizes
                    </span></>
                  )}
                </td></tr>
              )}
              {report.busyWeeks.total > 0 && (
                <tr><td>Two games in a week</td><td>
                  {report.busyWeeks.total} team-week{report.busyWeeks.total === 1 ? '' : 's'},
                  no team more than {report.busyWeeks.worstTeam}
                  {Object.keys(report.busyWeeks.byMonth).length > 0 && (
                    <> — {Object.entries(report.busyWeeks.byMonth).sort()
                      .map(([mo, n]) => `${mo} ${n}`).join(', ')}</>
                  )}
                </td></tr>
              )}
              {report.ownerFirst > 0 && (
                <tr><td>Reserved ice</td><td>
                  {report.ownerFirst} games went to the division the slot is held for
                  {report.ownerReleased > 0
                    ? `, and ${report.ownerReleased} slots opened up once that division had its games`
                    : ''}
                </td></tr>
              )}
              {practiceReport && (
                <tr><td>Practices</td><td>
                  {practiceReport.practices} booked, {practiceReport.evaluations} evaluations
                  {practiceReport.unusedPracticeSlots > 0
                    ? `, ${practiceReport.unusedPracticeSlots} practice slots left over` : ''}
                </td></tr>
              )}
              {report.kept + report.keptPlayoff > 0 && (
                <tr><td>Left alone</td><td>
                  {report.kept > 0 && `${report.kept} away or locked games`}
                  {report.kept > 0 && report.keptPlayoff > 0 && ', '}
                  {report.keptPlayoff > 0 && `${report.keptPlayoff} bracket games`}
                  {' kept exactly where they were'}
                </td></tr>
              )}
              {practiceReport?.issues.map((t, i) => (
                <tr key={`pi${i}`}><td /><td><span className="flag wrn">{t}</span></td></tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {showEvals && (
        <div className="panel">
          <div className="editor-head">
            <h3>Evaluations</h3>
            <span className={ready.fulfilled ? 'flag ok' : 'flag wrn'}>
              {ready.percent}% ready — {ready.ready} of {ready.total} division
              {ready.total === 1 ? '' : 's'}
            </span>
          </div>
          <p className="lede" style={{ marginBottom: 12 }}>
            Evaluations come first. A division plays nothing — no game, no practice — until its
            last session is done, so these dates set when each level's season can start. A
            division is ready when it has the sessions it asked for and nothing is scheduled
            before them. Set how many each level needs on Setup; zero means it does not run them.
          </p>
          <table>
            <thead>
              <tr><th>Division</th><th>Ready</th><th>When</th>
                <th>Plays from</th><th className="num">Sheets</th></tr>
            </thead>
            <tbody>
              {evals.filter((e) => e.wanted > 0 || e.dates.length > 0).map((e) => (
                <tr key={e.divisionId}>
                  <td><span className="chip div">{nameOf.division(e.divisionId)}</span></td>
                  <td>
                    {e.fulfilled
                      ? <span className="flag ok">Ready</span>
                      : <span className="flag wrn">{e.blockers.join('; ')}</span>}
                  </td>
                  <td>{e.dates.length
                    ? e.dates.map((d) => `${fmtDate(d)} (${fmtDay(d)})`).join(', ')
                    : <span className="muted">—</span>}</td>
                  <td>{e.playsFrom
                    ? <>{fmtDate(e.playsFrom)}</>
                    : <span className="muted">anytime</span>}</td>
                  <td className="num muted">{e.booked} of {e.wanted || e.booked}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {suggestions.length > 0 && (
        <div className="panel" style={{ borderLeft: '3px solid var(--warn)' }}>
          <h3>Ice that could fill the gaps</h3>
          <p className="lede" style={{ marginBottom: 12 }}>
            Nothing here has been changed. These are slots that could be used for something other
            than what they were booked as, cheapest first — out-of-play ice before empty ice,
            empty ice before ice somebody is on. Untick anything you want left alone.
          </p>
          <div className="scroll-x">
            <table>
              <thead>
                <tr><th /><th>Date</th><th>Day</th><th>Time</th><th>Rink</th>
                  <th>Booked as</th><th>Would become</th><th>Why this one</th></tr>
              </thead>
              <tbody>
                {suggestions.map((s2) => (
                  <tr key={s2.slotId}>
                    <td>
                      <input type="checkbox" checked={picked.has(s2.slotId)}
                        aria-label={`use ${s2.date} ${fmtTime(s2.start)} for ${s2.to}`}
                        onChange={(e) => setPicked((prev) => {
                          const next = new Set(prev);
                          if (e.target.checked) next.add(s2.slotId); else next.delete(s2.slotId);
                          return next;
                        })} />
                    </td>
                    <td>{fmtDate(s2.date)}</td>
                    <td className="muted">{fmtDay(s2.date)}</td>
                    <td>{fmtTime(s2.start)}</td>
                    <td>{s2.rink}</td>
                    <td className="muted">{s2.from}</td>
                    <td><strong>{s2.to}</strong>{s2.divisionId
                      ? <span className="chip div" style={{ marginLeft: 6 }}>{nameOf.division(s2.divisionId)}</span> : null}</td>
                    <td className="muted">{s2.why}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div className="row" style={{ marginTop: 12, marginBottom: 0 }}>
            <button className="btn go" disabled={!picked.size} onClick={() => {
              const take = suggestions.filter((s2) => picked.has(s2.slotId));
              onChange(applySuggestions(season, take,
                'Repurposed to fill a gap in the schedule'));
              setSuggestions([]);
              setPicked(new Set());
            }}>
              Use {picked.size} slot{picked.size === 1 ? '' : 's'} this way
            </button>
            <button className="btn line" onClick={() => { setSuggestions([]); setPicked(new Set()); }}>
              Leave the ice as it is
            </button>
            <span className="muted">Then generate again to fill them.</span>
          </div>
        </div>
      )}

      <div ref={editorRef}>
        {editing && (() => {
          const g = season.games.find((x) => x.id === editing);
          return g ? (
            <GameEditor season={season} manifest={manifest} game={g}
              onApply={onChange} onClose={() => setEditing(null)} />
          ) : null;
        })()}
      </div>

      {shown.length === 0 ? (
        <div className="empty">
          <p>{rows.length
            ? 'Nothing matches those filters. Widen Show, or pick a different division.'
            : 'No ice booked yet. Import a Finnly export on Ice, then generate.'}</p>
        </div>
      ) : (
        <div className="scroll-x"><table className={fresh ? 'fresh' : ''}>
          <thead>
            <tr><th className="num">#</th><th>Date</th><th>Day</th><th>Time</th><th>Rink</th>
              <th>What</th><th>Division</th><th>Who</th><th /></tr>
          </thead>
          <tbody>
            {shown.map((r, i) => (
              <tr key={r.key} className={editing === r.game?.id ? 'is-current' : ''}>
                <td className="num muted">{i + 1}</td>
                <td>{fmtDate(r.date)}</td>
                <td className="muted">{fmtDay(r.date)}</td>
                <td>{fmtTime(r.start)}</td>
                <td>
                  {r.rink}
                  {r.away && <span className="chip away" title="Played at another rink">away</span>}
                  {r.game?.locked && <span className="chip lock" title="The generator will not move this">locked</span>}
                </td>
                <td><Kind row={r} /></td>
                <td>
                  {r.divisionId
                    ? <span className="chip div">{nameOf.division(r.divisionId)}</span>
                    : <span className="muted">—</span>}
                </td>
                <td>{who(r, name)}</td>
                <td>
                  {r.game && (
                    <button className="btn line" onClick={() => setEditing(r.game!.id)}>Edit</button>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table></div>
      )}
    </>
  );
}

function Kind({ row }: { row: Row }) {
  if (row.kind === 'game') {
    const t = row.game?.type ?? 'regular';
    return t === 'regular'
      ? <span className="chip kind game">Game</span>
      : <span className="chip kind po">{t}</span>;
  }
  if (row.kind === 'practice') return <span className="chip kind prac">Practice</span>;
  if (row.kind === 'evaluation') return <span className="chip kind eval">Evaluation</span>;
  return <span className="chip kind free">Free</span>;
}

function who(r: Row, name: Map<string, string>) {
  if (r.kind === 'game') {
    const h = r.game!.homeTeamId ? name.get(r.game!.homeTeamId) ?? r.game!.homeTeamId : r.game!.homeLabel;
    const a = r.game!.awayTeamId ? name.get(r.game!.awayTeamId) ?? r.game!.awayTeamId : r.game!.awayLabel;
    return <>{h} <span className="muted">v</span> {a}</>;
  }
  if (r.kind === 'free') {
    const s = r.slot!;
    if (s.ownerDivisionId) {
      return (
        <span className="muted">
          held for {s.ownerDivisionId}
          {s.ownerPolicy === 'priority' ? ', releases when they are done' : ', reserved'}
        </span>
      );
    }
    if (s.use === 'playoff') {
      return <span className="muted">held for the playoffs, nothing on it yet</span>;
    }
    return <span className="muted">{s.use === 'game' ? 'game ice, nothing on it' : `${s.use} ice, nothing on it`}</span>;
  }
  if (!r.teamIds.length) return <span className="flag wrn">nobody assigned</span>;
  return <>{r.teamIds.map((t) => name.get(t) ?? t).join(', ')}</>;
}

import { useMemo, useState } from 'react';
import type { Season, LeagueManifest, Game, Division } from '@league/core';
import {
  BRACKET_SIZES, bracketGameCount, bracketProgress, bracketRounds, clearPlayoffs,
  codeOfGameId, fmtDate, fmtDay, fmtTime, gameWhen, isBracketSize, isPlayed, playoffGames,
  resolveBracket, ROUND_LABELS, standings,
} from '@league/core';
import { generatePlayoffs, playoffIceAvailable, type PlayoffReport } from '@league/engine';
import { names } from '../lib/names';

/**
 * Brackets.
 *
 * Seeds are live: they come from the standings as they stand, so the bracket
 * is readable the moment a division has a table, and it firms up as the last
 * results go in. Nothing here is hand-typed twice.
 */
export function Playoffs(
  { season, manifest, onChange }:
  { season: Season; manifest: LeagueManifest; onChange: (s: Season) => void },
) {
  // Held on the season, not in this component: the generator reads the same
  // setting when it decides how much ice to hold back for the brackets, and
  // the two must not disagree.
  const consolation = season.playoffConsolation;
  const [restDays, setRestDays] = useState(0);
  const [report, setReport] = useState<PlayoffReport | null>(null);
  const [busy, setBusy] = useState(false);

  const slot = useMemo(() => new Map(season.slots.map((s) => [s.id, s])), [season]);
  const name = useMemo(() => new Map(season.teams.map((t) => [t.id, t.name])), [season]);
  const nameOf = useMemo(() => names(season), [season]);
  const table = useMemo(() => standings(season, manifest), [season, manifest]);
  const bracket = playoffGames(season);

  const qualifying = season.divisions.filter((d) => d.playoffTeams > 0);
  const wanted = qualifying.reduce((n, d) =>
    n + (isBracketSize(d.playoffTeams) ? bracketGameCount(d.playoffTeams, consolation) : 0), 0);

  function setDivision(id: string, patch: Partial<Division>) {
    onChange({
      ...season,
      divisions: season.divisions.map((d) => (d.id === id ? { ...d, ...patch } : d)),
    });
  }

  function build() {
    setBusy(true);
    setTimeout(() => {
      try {
        const { games, report: r } = generatePlayoffs(season, manifest, { consolation, restDays });
        setReport(r);
        onChange({ ...season, games });
      } finally { setBusy(false); }
    }, 16);
  }

  function clear() {
    setReport(null);
    onChange(clearPlayoffs(season));
  }

  if (!manifest.capabilities.playoffs) {
    return (
      <>
        <h2>Playoffs</h2>
        <div className="empty">
          <p><strong>{manifest.name}</strong> does not run playoffs — the regular-season table
            decides it. That is a league rule, held in the league manifest, not a setting on this
            season.</p>
          <p className="muted">To change it, set <code>capabilities.playoffs</code> for{' '}
            <code>{manifest.id}</code> in <code>packages/core/src/manifest.ts</code>.</p>
        </div>
      </>
    );
  }

  return (
    <>
      <h2>Playoffs</h2>
      <p className="lede">
        Pick how many teams qualify in each division and the bracket builds itself, seeded off the
        standings and fitted into the ice left after the regular season. Finals go as late as the
        booked ice allows; every earlier round lands before the round it feeds.
      </p>

      <div className="panel">
        <h3>Who qualifies</h3>
        <table>
          <thead>
            <tr><th>Division</th><th className="num">Teams</th><th>Qualify</th>
              <th className="num">Games</th><th>Ice free after their season</th></tr>
          </thead>
          <tbody>
            {season.divisions.map((d) => {
              const teams = season.teams.filter((t) => t.divisionId === d.id).length;
              const ice = playoffIceAvailable(season, manifest, d.id);
              const slots = ice.reduce((n, x) => n + x.slots, 0);
              const need = isBracketSize(d.playoffTeams)
                ? bracketGameCount(d.playoffTeams, consolation) : 0;
              return (
                <tr key={d.id}>
                  <td><strong>{d.name}</strong></td>
                  <td className="num">{teams}</td>
                  <td>
                    <select value={d.playoffTeams} aria-label={`${d.name} playoff teams`}
                      onChange={(e) => setDivision(d.id, { playoffTeams: +e.target.value })}>
                      <option value={0}>No playoffs</option>
                      {BRACKET_SIZES.filter((n) => n <= Math.max(teams, 2)).map((n) => (
                        <option key={n} value={n}>Top {n}</option>
                      ))}
                    </select>
                  </td>
                  <td className="num">{need || <span className="muted">—</span>}</td>
                  <td className={slots < need ? 'flag wrn' : 'muted'}>
                    {slots} slot{slots === 1 ? '' : 's'} over {ice.length} night
                    {ice.length === 1 ? '' : 's'}
                    {slots < need ? ' — short' : ''}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
        <p className="muted" style={{ margin: '10px 0 0' }}>
          Those nights are the same ice: divisions share it, so the counts overlap and the
          totals do not add up. Build the brackets to see what actually fits.
        </p>
      </div>

      <div className="row">
        <div className="field">
          <label htmlFor="cons">Third-place game</label>
          <select id="cons" value={consolation ? 'yes' : 'no'}
            onChange={(e) => onChange({
              ...season, playoffConsolation: e.target.value === 'yes',
            })}>
            <option value="no">No — beaten semifinalists are done</option>
            <option value="yes">Yes — losers play for third</option>
          </select>
        </div>
        <div className="field">
          <label htmlFor="rest">Rest between rounds</label>
          <select id="rest" value={restDays} onChange={(e) => setRestDays(+e.target.value)}>
            <option value={0}>None — next day is fine</option>
            <option value={1}>1 clear day</option>
            <option value={2}>2 clear days</option>
          </select>
        </div>
        <div className="field">
          <label>&nbsp;</label>
          <button className="btn go" onClick={build} disabled={busy || !qualifying.length}>
            {busy ? 'Working…' : bracket.length ? 'Rebuild brackets' : 'Build brackets'}
          </button>
        </div>
        <div className="field">
          <label>&nbsp;</label>
          <button className="btn line" onClick={() => {
            if (confirm('Remove every bracket game? The ice they hold goes back in the pool.')) clear();
          }} disabled={!bracket.length}>Clear brackets</button>
        </div>
        <div className="field">
          <label>&nbsp;</label>
          <span className="muted">
            {bracket.length ? `${bracket.length} bracket games` : `${wanted} games to build`}
          </span>
        </div>
      </div>

      {report && (
        <div className="panel">
          <h3>Last run</h3>
          <table>
            <tbody>
              {report.byDivision.map((d) => (
                <tr key={d.divisionId}>
                  <td style={{ width: 170 }}><span className="chip div">{nameOf.division(d.divisionId)}</span>{' '}
                    top {d.size}</td>
                  <td>
                    <span className={d.placed < d.needed ? 'flag err' : 'flag ok'}>
                      {d.placed} of {d.needed} placed
                    </span>{' '}{d.note}
                  </td>
                </tr>
              ))}
              {report.finalsOn && (
                <tr><td>Finals</td><td>{fmtDate(report.finalsOn)}, {fmtDay(report.finalsOn)}</td></tr>
              )}
              <tr><td>Ice still free</td><td>{report.spareSlots} game slot
                {report.spareSlots === 1 ? '' : 's'} with nothing on {report.spareSlots === 1 ? 'it' : 'them'}</td></tr>
            </tbody>
          </table>
        </div>
      )}

      {!bracket.length ? (
        <div className="empty">
          <p>No brackets yet. Set how many teams qualify above, then build.</p>
          <p className="muted">Seeds read straight off the standings, so you can build the bracket
            now and watch it settle as results come in.</p>
        </div>
      ) : season.divisions.filter((d) => bracketRounds(season, d.id).length).map((d) => {
        const rounds = bracketRounds(season, d.id);
        const prog = bracketProgress(season, d.id);
        const seeds = table.filter((r) => r.divisionId === d.id).slice(0, d.playoffTeams);
        return (
          <div className="panel" key={d.id}>
            <div className="editor-head">
              <h3>{d.name}</h3>
              <span className="muted">
                {prog.champion
                  ? <span className="flag ok">{prog.champion} wins it</span>
                  : prog.pendingRegular
                    ? `${prog.pendingRegular} regular-season game${prog.pendingRegular === 1 ? '' : 's'} still to play — seeds can move`
                    : 'seeds final'}
              </span>
            </div>

            {seeds.length > 0 && (
              <p className="muted" style={{ margin: '0 0 10px' }}>
                {seeds.map((r, i) => (
                  <span key={r.teamId}>{i ? ' · ' : ''}<strong>{i + 1}</strong> {r.teamName}</span>
                ))}
              </p>
            )}

            <div className="bracket">
              {rounds.map((round, ri) => (
                <div className="round" key={ri}>
                  <h4>{round.length === 1 || round[0]!.type !== 'final'
                    ? ROUND_LABELS[round[0]!.type] ?? `Round ${ri + 1}`
                    : 'Final'}</h4>
                  {round.map((g) => <Tie key={g.id} game={g} season={season} name={name} slot={slot} />)}
                </div>
              ))}
            </div>
          </div>
        );
      })}
    </>
  );
}

/** One bracket game: who, when, where, and the score if it has been played. */
function Tie(
  { game: g, name, slot }:
  {
    game: Game; season: Season; name: Map<string, string>;
    slot: Map<string, import('@league/core').Slot>;
  },
) {
  const w = gameWhen(g, slot);
  const played = isPlayed(g) && g.homeTeamId && g.awayTeamId;
  const winner = played && g.homeGoals !== g.awayGoals
    ? (g.homeGoals! > g.awayGoals! ? g.homeTeamId : g.awayTeamId) : null;
  const side = (id: string | null, label: string, goals: number | null) => (
    <div className={`side${id && winner === id ? ' won' : ''}${id ? '' : ' tbd'}`}>
      <span className="who">{id ? name.get(id) ?? id : label}</span>
      <span className="goals">{goals ?? ''}</span>
    </div>
  );
  return (
    <div className="tie">
      <div className="tie-head">
        <span className="code">{codeOfGameId(g.id).toUpperCase()}</span>
        {w ? <span>{fmtDate(w.date)} · {fmtTime(w.start)} · {w.rink}</span>
          : <span className="flag err">no ice</span>}
      </div>
      {side(g.homeTeamId, g.homeLabel, g.homeGoals)}
      {side(g.awayTeamId, g.awayLabel, g.awayGoals)}
    </div>
  );
}

