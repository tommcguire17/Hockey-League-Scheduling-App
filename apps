test('opening the editor from the bottom of the schedule scrolls to it', async ({ page }) => {
  await openFixture(page);
  await page.getByRole('button', { name: 'Schedule', exact: true }).click();
  await page.getByRole('button', { name: /Generate/ }).click();
  await expect(page.getByText('Last run')).toBeVisible();

  const main = page.locator('.main');
  // Go to the bottom and edit the last game, which is where the editor opening
  // silently at the top was invisible.
  await main.evaluate((el) => { el.scrollTop = el.scrollHeight; });
  const before = await main.evaluate((el) => el.scrollTop);
  await page.locator('table').last().locator('tbody tr').last()
    .getByRole('button', { name: 'Edit' }).click();

  const editor = page.locator('.editor');
  await expect(editor).toBeVisible();
  // In view, not merely in the document.
  await expect.poll(async () => {
    const box = await editor.boundingBox();
    const pane = await main.boundingBox();
    if (!box || !pane) return false;
    return box.y + box.height > pane.y && box.y < pane.y + pane.height;
  }).toBe(true);
  // On a long tab it must actually have moved. The fixture's schedule is short
  // enough to fit in one screen, where the right answer is to move nothing, so
  // only hold it to that when there was a real scroll to undo.
  if (before > 200) {
    expect(await main.evaluate((el) => el.scrollTop)).toBeLessThan(before);
  }
});

